default_platform(:ios)

WORKSPACE = "Donmani.xcworkspace"
APP_SCHEME = "Donmani"
TEST_SCHEME = "Donmani-Workspace"

platform :ios do
  desc "Tuist로 프로젝트 생성 (모든 레인의 선행 단계)"
  lane :generate do
    sh("cd .. && tuist install && tuist generate --no-open")
  end

  desc "전체 모듈 단위 테스트"
  lane :test do
    generate
    run_tests(
      workspace: WORKSPACE,
      scheme: TEST_SCHEME,
      device: "iPhone 16 Pro",
      clean: true
    )
  end

  desc "TestFlight 배포"
  lane :beta do
    generate
    increment_build_number(build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"))
    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      export_method: "app-store"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "App Store 제출"
  lane :release do
    generate
    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      export_method: "app-store"
    )
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end
